# The repo stores LF. Every source type is listed so git, .editorconfig and the
# linter agree, whatever core.autocrlf says on the machine.
* text=auto

# Source, config and prose: LF
*.ts    text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.rs    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.lock  text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
.editorconfig  text eol=lf

# PowerShell, including generated-script templates: CRLF, as Windows PowerShell 5.1 expects
*.ps1      text eol=crlf
*.ps1.tmpl text eol=crlf
*.psm1     text eol=crlf
*.psd1     text eol=crlf

# Binaries
*.png  binary
*.ico  binary
*.icns binary
*.woff2 binary
